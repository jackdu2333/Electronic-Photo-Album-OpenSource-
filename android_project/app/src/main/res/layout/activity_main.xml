<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117">

    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/server_setup_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="#0D1117">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="40dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/server_setup_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#1E2631"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:text="@string/server_setup_badge"
                android:textAllCaps="true"
                android:textColor="#B6C3D6"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/server_setup_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="@string/server_setup_title"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/server_setup_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="@string/server_setup_subtitle"
                android:textColor="#A7B1BE"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/server_url_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="#18202B"
                android:hint="@string/server_setup_hint"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:maxLines="1"
                android:minHeight="56dp"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#738195" />

            <TextView
                android:id="@+id/server_status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:textColor="#FFB4B4"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/save_server_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:backgroundTint="#E8EEF9"
                android:minHeight="54dp"
                android:text="@string/server_setup_save"
                android:textAllCaps="false"
                android:textColor="#111827"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/server_setup_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="@string/server_setup_footer"
                android:textColor="#7F8A99"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/change_server_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:backgroundTint="#AA111827"
        android:minHeight="44dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/change_server"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:visibility="gone" />

</FrameLayout>
